# News Runtime
BANSO_NEWS_RETRIEVAL_ROUTES=web  # web | local | local,web
BANSO_MAX_EXTRACTION_CONCURRENCY=4
BANSO_DOCUMENT_FETCHER=http  # http | jina

# Policy and evidence extraction LLM (local or hosted OpenAI-compatible API)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=unused
VLLM_MODEL=
VLLM_TIMEOUT_SECONDS=60
BANSO_EXTRACTION_LLM_EXTRA_BODY=

# Answer synthesis LLM (may reuse the same OpenAI-compatible API)
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_TIMEOUT_SECONDS=60

# Tavily
BANSO_TAVILY_API_KEY=
BANSO_TAVILY_BASE_URL=https://api.tavily.com

# Jina Reader document fetcher (API key is optional)
BANSO_JINA_API_KEY=

# Local corpus
BANSO_CORPUS_REGISTRY_PATH=config/trusted_sources.json
BANSO_CORPUS_DATABASE_PATH=data/corpus.sqlite3
BANSO_CORPUS_INDEX_PATH=data/corpus.lance
BANSO_CORPUS_SEARCH_MODE=vector  # bm25 | vector | hybrid

# Embedding
BANSO_EMBEDDING_PROVIDER=openai  # openai | jina
BANSO_EMBEDDING_MODEL=
BANSO_EMBEDDING_DIMENSIONS=
BANSO_EMBEDDING_BASE_URL=
BANSO_EMBEDDING_API_KEY=
